@{
}
<h2 class="fw-bold mt-4">📊 View Reports</h2>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Total Users</h6>
            <h2 class="fw-bold text-primary">@ViewBag.TotalUsers</h2>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Donors</h6>
            <h2 class="fw-bold text-success">@ViewBag.Donors</h2>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Volunteers</h6>
            <h2 class="fw-bold text-primary">@ViewBag.Volunteers</h2>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Active Volunteers</h6>
            <h2 class="fw-bold text-primary">@ViewBag.ActiveVolunteers</h2>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Active Campaigns</h6>
            <h2 class="fw-bold text-primary">@ViewBag.ActiveCampaigns</h2>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Total Donations</h6>
            <h2 class="fw-bold text-success">R@(ViewBag.TotalDonations.ToString("N0"))</h2>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Average Donation</h6>
            <h2 class="fw-bold text-primary">R@(ViewBag.AvgDonation.ToString("N0"))</h2>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card shadow-sm border-0 text-center p-3">
            <h6 class="text-muted text-uppercase fw-bold">Total Volunteer Shifts</h6>
            <h2 class="fw-bold text-primary">@ViewBag.TotalShifts</h2>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <button onclick="window.print()" class="btn btn-primary btn-pill px-4">📥 Download PDF (Print)</button>
    <a asp-action="Index" class="btn btn-outline-secondary btn-pill px-4 ms-2">← Back to Dashboard</a>
</div>

<p class="text-center text-muted mt-4">Report generated on @DateTime.Now.ToString("f")</p>