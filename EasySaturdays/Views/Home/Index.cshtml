@model IEnumerable<EasySaturdays.Models.Campaign>

<!-- Hero Section -->
<div class="hero-section">
    <h1>Empowering <span>Tembisa</span> Together</h1>
    <p>Join The Easy Saturdays Foundation in driving social upliftment through community support, education, and youth empowerment in Ekurhuleni.</p>
    <div class="d-flex justify-content-center gap-3">
        <a asp-action="Campaigns" class="btn btn-warning btn-pill px-4">View Campaigns</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-pill px-4">Get Involved</a>
    </div>
</div>

<!-- Stats Section -->
<div class="stats-grid mb-5">
    <div class="stat-card">
        School Shoes Distributed
        <div class="number">1,200+</div>
    </div>
    <div class="stat-card">
        Winter Hampers Delivered
        <div class="number">850+</div>
    </div>
    <div class="stat-card">
        Active Volunteers
        <div class="number">200+</div>
    </div>
</div>